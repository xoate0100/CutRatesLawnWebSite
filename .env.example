# =============================================================================
# Cut Rates Lawn Website — Environment Variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values (especially phone, email, and URLs).
# 3. Never commit .env — it is gitignored.
#
# NEXT_PUBLIC_* variables are embedded in the browser bundle (safe for public info only).
# Variables without NEXT_PUBLIC_ stay server-side only.
# =============================================================================

# --- Site URL (required) -------------------------------------------------------
# Used for Open Graph links, canonical URLs, and production metadata.
# Local dev: http://localhost:3000
# Production: your live domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact (public — shown in header, footer, contact page) -------
NEXT_PUBLIC_BUSINESS_NAME=Cut Rates Lawn Care
NEXT_PUBLIC_BUSINESS_PHONE_E164=+13169255050
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=(316) 925-5050
NEXT_PUBLIC_BUSINESS_EMAIL=info@cutrateslawn.com
NEXT_PUBLIC_BUSINESS_ADDRESS_LINE1=226 W. Main Street Suite 1
NEXT_PUBLIC_BUSINESS_ADDRESS_CITY_STATE_ZIP=Valley Center, KS 67147

# --- Customer portal -----------------------------------------------------------
# FieldPortals (or your billing/customer portal). Opens in a new tab from header/footer.
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=https://cutrateslawn.fieldportals.com/landing/index

# --- Social (optional — used in layout metadata) -------------------------------
NEXT_PUBLIC_TWITTER_HANDLE=@cutratelawn

# --- Analytics (optional — add when you connect Google Analytics) --------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Form submissions / leads --------------------------------------------------
# At least one delivery channel required for contact success (else API returns 503).
# Prefer Go High Level (CRM + workflows). Webhook / Resend are optional extras.
#
# Go High Level / LeadConnector (sub-account Private Integration Token)
# See docs/integrations/GOHIGHLEVEL.md
# GHL_PRIVATE_INTEGRATION_TOKEN=pit-xxxxxxxx
# GHL_LOCATION_ID=
# GHL_LEAD_TAGS=
# Optional: map site fields onto existing GHL custom fields (IDs from Locations → Custom Fields)
# Recommended for Cut Rates Lawn location:
# GHL_CF_SERVICE_ID=f1Sn1OZOXVB5VwI2xHBB
# GHL_CF_MESSAGE_ID=CkymWjT4aAlONIQPlyjc
# GHL_CF_REQUEST_ID=
#
# CONTACT_FORM_WEBHOOK_URL=https://hooks.example.com/contact
# NEWSLETTER_WEBHOOK_URL=https://hooks.example.com/newsletter
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=leads@cutrateslawn.com
# LEAD_NOTIFY_EMAIL=info@cutrateslawn.com
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
# NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=

# --- Agentic dev (optional — only for live external agent calls) ---------------
# CUTRATES_AGENTIC_LIVE_ENABLED=1

# --- Media / GCS (Envato → gs://site_photo_storage pipeline) -------------------
NEXT_PUBLIC_MEDIA_BASE_URL=https://storage.googleapis.com/site_photo_storage
GCS_MEDIA_BUCKET=site_photo_storage
GCS_MEDIA_PREFIX=cutrateslawn/prod
