# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example committed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# Visual Studio
.vs/

# typescript
*.tsbuildinfo
next-env.d.ts

playwright-report/
test-results/

# Redesign audit / scratch artifacts
artifacts/redesign/
artifacts/lh-tmp/
*.log
artifacts-playwright*.log
build-final.log

# Media pipeline binaries (registries under docs/media/ stay committed)
media/inbox/*
!media/inbox/.gitkeep
media/staging/*
!media/staging/.gitkeep
media/processed/*
!media/processed/.gitkeep
media/quarantine/*
!media/quarantine/.gitkeep
media/archive/*
!media/archive/.gitkeep
media/archive/already_in_registry/**
.vercel
.env*
