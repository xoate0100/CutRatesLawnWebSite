{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "media",
    "artifacts",
    "agentic",
    "0_phase0_bootstrap",
    "3_bootstrap_scripts",
    "5_reference_architectures",
    "app/admin",
    "app/api/health/strapi",
    "app/service-worker.ts",
    "components/account",
    "components/admin",
    "components/auth",
    "components/dev",
    "lib/smart-api.ts",
    "lib/schema-discovery.ts",
    "lib/schema-monitor.ts",
    "lib/schema-validator.ts",
    "lib/init-schema.ts",
    "lib/di",
    "lib/services",
    "lib/hooks/use-cms-data.ts",
    "lib/api-client.ts",
    "lib/blog-api.ts",
    "lib/data-transformer.ts",
    "lib/image-metadata.ts",
    "lib/import-error-handler.ts",
    "lib/analytics/core.ts",
    "hooks/use-bundles-data.ts",
    "hooks/use-data-fetching.ts",
    "hooks/use-form-validation.ts",
    "hooks/use-services-data.ts"
  ]
}
